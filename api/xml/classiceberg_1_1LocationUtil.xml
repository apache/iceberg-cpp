        <type>std::string_view</type>
        <definition>static std::string_view iceberg::LocationUtil::RelativizeLocation</definition>
        <argsstring>(std::string_view table_location, std::string_view location)</argsstring>
        <name>RelativizeLocation</name>
        <qualifiedname>iceberg::LocationUtil::RelativizeLocation</qualifiedname>
        <param>
          <type>std::string_view</type>
          <declname>table_location</declname>
        </param>
        <param>
          <type>std::string_view</type>
          <declname>location</declname>
        </param>
        <briefdescription>
<para>Relativize a location against a table location. </para>
        </briefdescription>
        <detaileddescription>
<para>If the location starts with the table location immediately followed by <computeroutput>/</computeroutput>, the remainder after that separator is returned. Otherwise the location is returned unchanged. A table location that ends in <computeroutput>/</computeroutput> already includes the separator. </para>
        </detaileddescription>
